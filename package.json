{
  "name": "svyazka-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-server.mjs && tsc -b && vite build",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node scripts/build-server.mjs && node --test tests/*.test.mjs",
    "check": "tsc -b --pretty false",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vkid/sdk": "^2.6.8",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
